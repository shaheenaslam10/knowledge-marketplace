# ============================================================================
# Production / staging environment — copy to .env.production or .env.staging
# on the deploy host. NEVER commit the filled-in file (.gitignore covers it).
#
# Canonical variable reference: docs/architecture/environments.md
# Deployment procedure:         docs/architecture/deployment.md
#
# The API container refuses to start if any of this is dangerous — it runs
# `manage.py check --deploy --tag production --fail-level WARNING` before it
# serves a single request (apps/core/checks.py). Treat a failed deploy here as
# the system doing its job.
# ============================================================================

# --- Which deployment is this? ---------------------------------------------
# Drives the production safety checks, the seed guard, and staging isolation.
DEPLOY_ENV=staging                      # staging | production
APP_VERSION=0.1.0

# --- Secrets ----------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_64_char_random_value

# --- Domains ----------------------------------------------------------------
# Three experiences (ADR-0013) + the API. Staging uses staging-* equivalents.
SITE_DOMAIN=www.example.com
APP_DOMAIN=app.example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com
APEX_DOMAIN=example.com
ACME_EMAIL=ops@example.com

ALLOWED_HOSTS=api.example.com
FRONTEND_URL=https://app.example.com
BACKEND_URL=https://api.example.com
CORS_ALLOWED_ORIGINS=https://www.example.com,https://app.example.com,https://admin.example.com
CSRF_TRUSTED_ORIGINS=https://www.example.com,https://app.example.com,https://admin.example.com

# --- Database ---------------------------------------------------------------
# In-compose Postgres (default). To use Neon instead: point DATABASE_URL at the
# Neon connection string, comment out the `db` service in docker-compose.prod.yml,
# and backups become provider-managed PITR (backup-recovery.md).
POSTGRES_USER=hem
POSTGRES_PASSWORD=CHANGE_ME_random_database_password
POSTGRES_DB=hem
DATABASE_URL=postgres://hem:CHANGE_ME_random_database_password@db:5432/hem

# --- Admin surface ----------------------------------------------------------
# NOT "admin/". An unguessable path removes the bulk of automated probing.
ADMIN_URL=CHANGE_ME_random_path/

# --- Security ---------------------------------------------------------------
COOKIE_SECURE=True
CSP_REPORT_ONLY=False                   # True only for a deliberate canary
LOG_LEVEL=INFO

# --- Email (console is REFUSED in deployments) ------------------------------
EMAIL_BACKEND_MODE=brevo                # smtp | brevo
DEFAULT_FROM_EMAIL=no-reply@example.com
BREVO_API_KEY=
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# --- Object storage (R2 — ADR-0006) -----------------------------------------
# FILE_STORAGE=local is an ERROR in production: container filesystems are
# ephemeral and every delivery would vanish on the next deploy.
FILE_STORAGE=r2
R2_BUCKET=hem-prod
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_REGION=auto
R2_PRESIGN_TTL_SECONDS=300

# --- Payments ---------------------------------------------------------------
# ManualGateway stays active until a provider is activated (ADR-0005). The
# checklist in docs/workflows/payments.md must be completed first.
PAYMENT_GATEWAY=manual
MANUAL_PAYMENT_INSTRUCTIONS=Transfer the exact amount to the platform account, then submit the payment reference on the order page.
MANUAL_WEBHOOK_SECRET=CHANGE_ME_random_webhook_secret
# PAYMENT_DEV_SELF_CONFIRM must NOT appear here — it is refused in deployments.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Worker -----------------------------------------------------------------
WORKERS=2
Q_TIMEOUT=300
Q_RETRY=360
Q_MAX_ATTEMPTS=3

# --- Frontend build-time public vars ----------------------------------------
# Inlined into the browser bundle at BUILD time (compose passes them as args).
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_WS_URL=wss://api.example.com
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Extra CSP origins, comma-separated (e.g. an R2 custom domain, error reporting)
# NEXT_PUBLIC_CSP_CONNECT_EXTRA=
# NEXT_PUBLIC_CSP_IMG_EXTRA=

# --- Backups (scripts/backup_db.sh) -----------------------------------------
# Losing this passphrase means losing every backup. Password manager, not here.
BACKUP_PASSPHRASE=CHANGE_ME_long_random_passphrase
BACKUP_DIR=./var/backups
BACKUP_RETENTION_DAYS=30
# Off-host copy. A backup that dies with the machine is not a backup.
# BACKUP_REMOTE_CMD=rclone copy --config /etc/rclone.conf
