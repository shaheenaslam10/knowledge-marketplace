# ============================================================================
# Hybrid Expert Marketplace — environment configuration
# Canonical docs: docs/architecture/environments.md (CI checks names match).
# Copy to .env for local dev; dev-safe defaults are baked into docker-compose.yml,
# so an empty copy works. NEVER commit real secrets.
# ============================================================================

# --- Core Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev   # dev | test | prod
# Which deployment this process IS. prod.py serves BOTH staging and production,
# so the settings module cannot tell them apart — this can. Drives the
# production safety checks (apps/core/checks.py), the seed guard, and staging
# isolation. Leave as `local` for development. (Phase 12 / ADR-0016)
DEPLOY_ENV=local                             # local | ci | staging | production
SECRET_KEY=dev-only-insecure-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
APP_VERSION=0.1.0

# --- Database (PostgreSQL — the only source of truth) ---
DATABASE_URL=postgres://hem:hem@db:5432/hem
# Compose-only knobs (db service)
POSTGRES_USER=hem
POSTGRES_PASSWORD=hem
POSTGRES_DB=hem

# --- Origins / CORS ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Background worker (django-q2, database-backed; no Redis) ---
WORKERS=4
Q_TIMEOUT=300
Q_RETRY=360
Q_MAX_ATTEMPTS=3

# --- API throttling ---
THROTTLE_ANON=30/min
THROTTLE_USER=120/min

# --- Payments (Phase 7: provider-agnostic domain shipped; ManualGateway active; stripe = seam until credentials verified) ---
PAYMENT_GATEWAY=manual            # manual (dev/test + operator fallback) | stripe (seam only until credentials verified)
MANUAL_PAYMENT_INSTRUCTIONS=Transfer the exact amount to the platform account; then submit the payment reference on the order page.
MANUAL_WEBHOOK_SECRET=dev-only-webhook-secret
PAYMENT_DEV_SELF_CONFIRM=1        # dev-only: student self-confirm on manual rails (NEVER production)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_API_COUNTRY=US

# --- Email (console in dev; SMTP/Brevo adapters with notifications in Phase 9) ---
DEFAULT_FROM_EMAIL=no-reply@localhost
# EMAIL_BACKEND_MODE=console        # console | smtp | brevo — implemented (Phase 8)
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# BREVO_API_KEY=

# --- Files (Phase 9: local disk default; R2/S3-compatible private bucket) ---
# FILE_STORAGE=r2 switches uploads/presigning to Cloudflare R2 via django-storages
# (docs/architecture/files-storage.md). R2 is optional — local is the dev default.
FILE_STORAGE=local                # local | r2
MEDIA_ROOT=./var/media
# R2_BUCKET=
# R2_ACCOUNT_ID=
# R2_ENDPOINT_URL=                 # optional override; derived from account id
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_REGION=auto
# R2_PRESIGN_TTL_SECONDS=300       # presigned GET lifetime (60..3600)

# --- Auth (Phase 2 — implemented) ---
ADMIN_URL=admin/
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
COOKIE_SECURE=False               # True in production (HTTPS-only cookies)
# THROTTLE_AUTH=10/min            # login/register/reset brute-force guard

# --- Security headers (prod settings; Phase 12 / ADR-0017) ---
# CSP is ENFORCING in deployments. Override only for a deliberate canary.
# CSP=                              # full policy override for Django responses
# CSP_REPORT_ONLY=False             # True = report violations without blocking
# PERMISSIONS_POLICY=
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# STATIC_ROOT=                      # collectstatic target; Caddy serves it

# --- Deployment: domains + TLS (docker-compose.prod.yml / deploy/Caddyfile) ---
# SITE_DOMAIN=www.example.com       # (marketing)
# APP_DOMAIN=app.example.com        # (auth)+(app)
# ADMIN_DOMAIN=admin.example.com    # (portal)
# API_DOMAIN=api.example.com        # Django
# ACME_EMAIL=ops@example.com        # Let's Encrypt registration
# READYZ_URL=                       # worker's readiness target (compose sets it)

# --- Backups (scripts/backup_db.sh, scripts/restore_backup.sh) ---
# BACKUP_PASSPHRASE=                # AES-256 key for dumps — password manager!
# BACKUP_DIR=./var/backups
# BACKUP_RETENTION_DAYS=30
# BACKUP_REMOTE_CMD=                # e.g. "rclone copy" — off-host copy hook

# --- Observability ---
LOG_LEVEL=INFO
# SENTRY_DSN=

# --- Feature flags ---
FEATURE_MANAGED_SERVICE=true

# --- Seed/demo ---
DJANGO_SEED_ADMIN_PASSWORD=admin-demo-1234

# --- Frontend (NEXT_PUBLIC_* — see also frontend/.env.example) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# SERVER_API_URL=http://backend:8000   # server-side fetch target inside compose
# Three-experience host mapping (ADR-0013). Middleware redirects host/path
# mismatches ONLY when all three are set — unset in dev so every path works
# on localhost:3000.
# NEXT_PUBLIC_MARKETING_HOST=www.example.com
# NEXT_PUBLIC_APP_HOST=app.example.com
# NEXT_PUBLIC_PORTAL_HOST=admin.example.com
# Extra CSP origins, comma-separated (R2 custom domain, error reporting, ...)
# NEXT_PUBLIC_CSP_CONNECT_EXTRA=
# NEXT_PUBLIC_CSP_IMG_EXTRA=

# --- Host port overrides (optional) ---
# POSTGRES_HOST_PORT=5432
# BACKEND_HOST_PORT=8000
# FRONTEND_HOST_PORT=3000
