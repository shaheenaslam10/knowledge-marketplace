# Frontend-only variables (Next.js reads *.env files from the frontend/ directory).
# Root .env (via docker compose) sets these too — this file is for non-Docker local dev.
# Canonical documentation: docs/architecture/environments.md

# Public (browser) URL of the Django API
NEXT_PUBLIC_API_URL=http://localhost:8000
# WebSocket base URL (Phase 9 consumers; harmless now)
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Canonical site origin (SEO metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side (RSC) URL of the API — docker-network name inside compose,
# leave unset outside Docker to fall back to NEXT_PUBLIC_API_URL.
# SERVER_API_URL=http://backend:8000
